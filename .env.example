# Environment configuration for LEC AI Router
# Copy this file to .env and adjust values to your deployment.

# ─── Remote Budget ────────────────────────────────────────────────────────────
# Hard cap on cumulative remote API spend per server session.
# $5.00 = ~250 calls at GPT-4o pricing ($0.02 worst-case per call).
# Lower this in staging, raise it in production as your team scales.
MAX_REMOTE_BUDGET=5.00

# Worst-case cost reserved per remote call at admission time.
# Based on GPT-4o: $5.00/1M input + $15.00/1M output
# 2,000 input + 500 output tokens → ≈$0.018, rounded to $0.02 for safety.
COST_PER_REMOTE_REQUEST=0.02

# ─── Latency Limits ───────────────────────────────────────────────────────────
# Cumulative in-flight latency cap across all admitted requests (ms).
# 600,000ms = 10 minutes of concurrent work before the circuit breaker engages.
# In a real system this would be a per-minute sliding window; this lifetime
# total is large enough not to trip on normal traffic bursts.
MAX_CUMULATIVE_LATENCY_MS=600000.0

# Realistic EMA seed latencies before any real observations are recorded.
# LOCAL  : quantized 7B model on a GPU (RTX 3090 / A10G) — ~250ms TTFT.
# REMOTE : GPT-4o / Claude Sonnet median TTFT + generation — ~800ms.
AVG_LOCAL_LATENCY_MS=250.0
AVG_REMOTE_LATENCY_MS=800.0

# ─── Queue ────────────────────────────────────────────────────────────────────
# Max concurrent local inference slots.
# 8 is appropriate for a single GPU node or 16-core CPU. Scale with hardware.
LOCAL_QUEUE_CAPACITY=8

# ─── Latency Tracker ──────────────────────────────────────────────────────────
EMA_ALPHA=0.25
LATENCY_WINDOW_SIZE=10

# ─── Reservation TTL ──────────────────────────────────────────────────────────
# Stale reservations older than this are automatically rolled back (seconds).
# 45s covers 3 retry attempts at 10s each for a slow remote API.
RESERVATION_TTL_SECONDS=45.0
REAPER_INTERVAL_SECONDS=5.0

# ─── Backends ─────────────────────────────────────────────────────────────────
# "mock" = simulated latency, no network (for tests / CI)
# "real" = Ollama (local) + Remote LLM Provider API (remote)
BACKEND_MODE=real

# Local backend: Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=my-nemotron:latest
OLLAMA_TIMEOUT_SECONDS=120.0

# Remote backend: any OpenAI-compatible provider
# Drop in your API key and endpoint — works with OpenAI, Anthropic, Together AI,
# Anyscale, vLLM, etc. without any code changes.
REMOTE_LLM_API_KEY=your_api_key_here
REMOTE_LLM_BASE_URL=https://api.openai.com/v1
REMOTE_LLM_MODEL=gpt-4o-mini
REMOTE_LLM_TIMEOUT_SECONDS=30.0

# Token pricing for cost accounting (per token, not per call).
# Default: GPT-4o-mini pricing — $0.15/1M input, $0.60/1M output.
REMOTE_LLM_INPUT_PRICE_PER_TOKEN=0.00000015
REMOTE_LLM_OUTPUT_PRICE_PER_TOKEN=0.0000006
